--- /dev/null
+++ b/cmd/aoikane-probe/main_js.go
@@ -0,0 +1,57 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"syscall/js"
+	"time"
+
+	pt "github.com/cwbudde/go-pocket-tts"
+)
+
+func main() {
+	result, err := measure()
+	if err != nil {
+		js.Global().Set("pocketProbeError", err.Error())
+		return
+	}
+	js.Global().Set("pocketProbeResult", string(result))
+}
+
+func measure() ([]byte, error) {
+	input := js.Global().Get("pocketProbeInput")
+	bytes := func(key string) []byte {
+		data := input.Get(key)
+		out := make([]byte, data.Length())
+		js.CopyBytesToGo(out, data)
+		return out
+	}
+	weights, tokenizer, state := bytes("weights"), bytes("tokenizer"), bytes("voice")
+	started := time.Now()
+	model, err := pt.LoadWithConfig(input.Get("model").String(), bytes("config"), weights, tokenizer)
+	if err != nil {
+		return nil, err
+	}
+	defer model.Close()
+	voice, err := pt.ParseVoice(state)
+	if err != nil {
+		return nil, err
+	}
+	load := time.Since(started).Seconds()
+	type run struct{ Seconds, AudioSeconds, RTF float64 }
+	runs := make([]run, 0, 3)
+	for range 3 {
+		started = time.Now()
+		pcm, err := model.Synthesize(context.Background(), input.Get("text").String(), voice, model.DefaultOptions())
+		if err != nil {
+			return nil, err
+		}
+		seconds := time.Since(started).Seconds()
+		audio := float64(len(pcm)) / pt.SampleRate
+		runs = append(runs, run{seconds, audio, seconds / audio})
+	}
+	return json.Marshal(struct {
+		LoadSeconds float64
+		Runs        []run
+	}{load, runs})
+}
