new file mode 100644
index 0000000..908fa78
--- /dev/null
+++ b/cmd/aoikane-probe/main.go
@@ -0,0 +1,112 @@
+//go:build !js
+
+package main
+
+import (
+	"context"
+	"encoding/binary"
+	"flag"
+	"fmt"
+	"log/slog"
+	"math"
+	"os"
+	"path/filepath"
+	"time"
+
+	pt "github.com/cwbudde/go-pocket-tts"
+)
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run() error {
+	assets := flag.String("assets", "", "directory containing config.yaml, model.safetensors and tokenizer.model")
+	voicePath := flag.String("voice", "", "precomputed voice file (default: embeddings/alba.safetensors under assets)")
+	text := flag.String("text", "", "text to synthesize")
+	out := flag.String("out", "output.wav", "output WAV path")
+	workers := flag.Int("workers", 1, "number of workers")
+	verbose := flag.Bool("verbose", false, "log synthesis stage timings")
+	flag.Parse()
+	if flag.NArg() != 0 || *assets == "" || *text == "" || *workers < 1 {
+		return fmt.Errorf("provide --assets and --text with a positive --workers value")
+	}
+	level := slog.LevelWarn
+	if *verbose {
+		level = slog.LevelDebug
+	}
+	slog.SetLogLoggerLevel(level)
+	pt.SetWorkers(*workers)
+
+	started := time.Now()
+	config, err := os.ReadFile(filepath.Join(*assets, "config.yaml"))
+	if err != nil {
+		return err
+	}
+	weights, err := os.ReadFile(filepath.Join(*assets, "model.safetensors"))
+	if err != nil {
+		return err
+	}
+	tokenizer, err := os.ReadFile(filepath.Join(*assets, "tokenizer.model"))
+	if err != nil {
+		return err
+	}
+	model, err := pt.LoadWithConfig(filepath.Base(*assets), config, weights, tokenizer)
+	if err != nil {
+		return err
+	}
+	defer model.Close()
+	if *voicePath == "" {
+		*voicePath = filepath.Join(*assets, "embeddings", "alba.safetensors")
+	}
+	voiceData, err := os.ReadFile(*voicePath)
+	if err != nil {
+		return err
+	}
+	voice, err := pt.ParseVoice(voiceData)
+	if err != nil {
+		return err
+	}
+	loaded := time.Since(started)
+	started = time.Now()
+	pcm, err := model.Synthesize(context.Background(), *text, voice, model.DefaultOptions())
+	if err != nil {
+		return err
+	}
+	elapsed := time.Since(started)
+	if err := writeWAV(*out, pcm); err != nil {
+		return err
+	}
+	fmt.Printf("load=%.3fs synth=%.3fs audio=%.3fs\n", loaded.Seconds(), elapsed.Seconds(), float64(len(pcm))/pt.SampleRate)
+	return nil
+}
+
+func writeWAV(path string, pcm []float32) error {
+	if len(pcm) == 0 || uint64(len(pcm)) > (math.MaxUint32-36)/2 {
+		return fmt.Errorf("invalid WAV sample count %d", len(pcm))
+	}
+	bytes := make([]byte, 0, 44+2*len(pcm))
+	bytes = append(bytes, "RIFF"...)
+	bytes = binary.LittleEndian.AppendUint32(bytes, uint32(36+2*len(pcm)))
+	bytes = append(bytes, "WAVEfmt "...)
+	bytes = binary.LittleEndian.AppendUint32(bytes, 16)
+	bytes = binary.LittleEndian.AppendUint16(bytes, 1) // PCM
+	bytes = binary.LittleEndian.AppendUint16(bytes, 1) // mono
+	bytes = binary.LittleEndian.AppendUint32(bytes, pt.SampleRate)
+	bytes = binary.LittleEndian.AppendUint32(bytes, 2*pt.SampleRate)
+	bytes = binary.LittleEndian.AppendUint16(bytes, 2)  // bytes per sample
+	bytes = binary.LittleEndian.AppendUint16(bytes, 16) // bits per sample
+	bytes = append(bytes, "data"...)
+	bytes = binary.LittleEndian.AppendUint32(bytes, uint32(2*len(pcm)))
+	for _, x := range pcm {
+		if math.IsNaN(float64(x)) || math.IsInf(float64(x), 0) {
+			return fmt.Errorf("synthesis produced a non-finite sample")
+		}
+		sample := int16(math.Round(math.Max(-1, math.Min(1, float64(x))) * 32767))
+		bytes = binary.LittleEndian.AppendUint16(bytes, uint16(sample))
+	}
+	return os.WriteFile(path, bytes, 0600)
+}
diff --git a/cmd/aoikane-probe/main_js.go b/cmd/aoikane-probe/main_js.go
new file mode 100644
